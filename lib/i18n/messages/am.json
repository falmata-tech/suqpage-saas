  "m77c94a76": "ሠራተኞችን ጨምረው ፈቃዳቸውን ያስተዳድሩ።",
  "m998971f7": "የመጀመሪያውን ምርት ወይም አገልግሎት ወደ ገጽዎ ይጨምሩ።",
