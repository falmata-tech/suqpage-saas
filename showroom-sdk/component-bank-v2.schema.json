{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suqpage.com/schemas/component-bank-v2.schema.json",
  "title": "SuqPage typed-content component-bank release",
  "description": "Portable bank 1.2 guidance. Server release, compatibility, media, tenant, and publication validation remains authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "components", "tokenPacks", "requiredSlots", "requiredCapabilities"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "release": { "type": "string", "pattern": "^showroom-bank@[1-9][0-9]*(\\.[0-9]+){0,2}$", "maxLength": 80 },
    "components": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/component" } },
    "tokenPacks": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "component-bank.schema.json#/$defs/tokenPack" } },
    "requiredSlots": { "type": "array", "uniqueItems": true, "maxItems": 8, "items": { "$ref": "component-bank.schema.json#/$defs/slot" } },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "allOf": [
        { "contains": { "const": "product_detail" } },
        { "contains": { "const": "add_to_inquiry" } },
        { "contains": { "const": "inquiry_cart_trigger" } }
      ],
      "maxItems": 5,
      "items": { "$ref": "component-bank.schema.json#/$defs/capability" }
    }
  },
  "$defs": {
    "contentType": { "enum": ["hero", "story", "highlights", "information", "call_to_action", "video"] },
    "contentMediaSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "required", "acceptedKinds", "minItems", "maxItems", "aspectRatio"],
      "properties": {
        "key": { "$ref": "component-bank.schema.json#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "required": { "type": "boolean" },
        "acceptedKinds": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["image", "video"] } },
        "minItems": { "type": "integer", "minimum": 0, "maximum": 12 },
        "maxItems": { "type": "integer", "minimum": 0, "maximum": 12 },
        "aspectRatio": { "enum": ["any", "landscape", "portrait", "square"] }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "slot", "codeReference", "repeatable", "providesCapabilities", "incompatibleWith", "properties", "bindings", "mediaSlots", "acceptedContentTypes", "contentMediaSlots"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*@[1-9][0-9]*$", "maxLength": 100 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "slot": { "$ref": "component-bank.schema.json#/$defs/slot" },
        "codeReference": { "type": "string", "pattern": "^components/showroom/bank/[A-Za-z0-9._/-]+\\.(?:ts|tsx)$", "maxLength": 200 },
        "repeatable": { "type": "boolean" },
        "providesCapabilities": { "type": "array", "maxItems": 5, "uniqueItems": true, "items": { "$ref": "component-bank.schema.json#/$defs/capability" } },
        "incompatibleWith": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "maxLength": 100 } },
        "properties": { "type": "array", "maxItems": 24, "items": { "$ref": "component-bank.schema.json#/$defs/property" } },
        "bindings": { "type": "array", "maxItems": 16, "items": { "$ref": "component-bank.schema.json#/$defs/binding" } },
        "mediaSlots": { "type": "array", "maxItems": 8, "items": { "$ref": "component-bank.schema.json#/$defs/mediaSlot" } },
        "acceptedContentTypes": { "type": "array", "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/contentType" } },
        "contentMediaSlots": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/contentMediaSlot" } }
      }
    }
  }
}
