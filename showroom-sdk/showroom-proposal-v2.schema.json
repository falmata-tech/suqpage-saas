{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirtpage.com/schemas/showroom-proposal-v2.schema.json",
  "title": "MirtPage typed-content showroom design proposal",
  "description": "Portable syntactic guidance. The server verifies the exact bank release, content compatibility, media, tenant, revision, and publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bankRelease", "tokenPack", "productDetailPattern", "rationale", "questions", "warnings", "sections"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "bankRelease": { "type": "string", "pattern": "^showroom-bank@[1-9][0-9]*(\\.[0-9]+){0,2}$", "maxLength": 80 },
    "tokenPack": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 80 },
    "customPalette": {
      "description": "Optional reviewed color override. tokenPack still controls typography, spacing, geometry, density, and media bounds.",
      "$ref": "showroom-design-system.schema.json#/items/properties/colors"
    },
    "productDetailPattern": {
      "description": "Reviewed product-detail presentation selected by rendered anatomy and content fit, never by industry name.",
      "enum": ["editorial", "technical", "product_stage", "compact"]
    },
    "rationale": { "type": "string", "maxLength": 2000 },
    "questions": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "warnings": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "sections": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "$ref": "#/$defs/section" } }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "component", "properties", "bindings", "contentBlockKey"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 80 },
        "component": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*@[1-9][0-9]*$", "maxLength": 100 },
        "properties": { "type": "object", "maxProperties": 24, "additionalProperties": { "$ref": "showroom-proposal.schema.json#/$defs/primitive" } },
        "bindings": { "type": "object", "maxProperties": 16, "additionalProperties": { "$ref": "showroom-proposal.schema.json#/$defs/bindingSource" } },
        "contentBlockKey": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 80 }
          ]
        },
        "surfaceRole": {
          "description": "Semantic section surface role used to pace the complete page.",
          "enum": ["canvas", "surface", "soft", "accent-soft", "secondary-soft", "strong", "inverse"]
        },
        "mediaIntegration": {
          "description": "Reviewed section-media treatment. Omit for the neutral natural treatment.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "enum": ["natural", "surface_blend", "ambient_overlay", "edge_fade", "split_bleed", "editorial_overlap", "product_stage", "hidden"]
            }
          ]
        }
      }
    }
  }
}
