{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suqpage.com/schemas/showroom-content.schema.json",
  "title": "SuqPage stockless showroom content proposal",
  "description": "Portable syntactic guidance. The SuqPage server parser, source, tenant, asset, and relationship checks remain authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "business", "collections", "categories", "products",
    "contentBlocks"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "business": { "$ref": "#/$defs/business" },
    "collections": {
      "type": "array",
      "description": "Compatibility field. Product category is the only active grouping; return an empty array.",
      "maxItems": 0,
      "items": { "$ref": "#/$defs/collection" }
    },
    "categories": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/category" }
    },
    "products": {
      "type": "array",
      "description": "Compatibility transport for public offerings. Each entry may be a standard product, made-to-order product, manufacturing capability, or production supply.",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/product" }
    },
    "contentBlocks": { "$ref": "showroom-content-blocks.schema.json" }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "nullableKey": {
      "oneOf": [{ "$ref": "#/$defs/key" }, { "type": "null" }]
    },
    "imageKey": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^(?:asset_[a-f0-9]{20})?$"
    },
    "videoKey": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^(?:asset_[a-f0-9]{20})?$"
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "designKey", "tagline", "description", "logoRef", "heroTitle",
        "heroSubtitle", "heroImageRef", "contactEmail", "whatsapp", "telegram",
        "tiktok", "processVideoRef", "isLive", "livePlatform", "liveUrl",
        "siteTitle", "siteDescription", "faviconRef"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "designKey": { "const": "composition" },
        "tagline": { "type": "string", "maxLength": 180 },
        "description": { "type": "string", "maxLength": 1200 },
        "logoRef": { "$ref": "#/$defs/imageKey" },
        "heroTitle": { "type": "string", "maxLength": 180 },
        "heroSubtitle": { "type": "string", "maxLength": 300 },
        "heroImageRef": { "$ref": "#/$defs/imageKey" },
        "contactEmail": { "type": "string", "maxLength": 160 },
        "whatsapp": { "type": "string", "maxLength": 40 },
        "telegram": { "type": "string", "maxLength": 80 },
        "tiktok": { "type": "string", "maxLength": 80 },
        "processVideoRef": { "$ref": "#/$defs/videoKey" },
        "isLive": { "type": "boolean" },
        "livePlatform": { "enum": ["", "tiktok", "facebook", "youtube", "google_meet"] },
        "liveUrl": { "type": "string", "maxLength": 500 },
        "siteTitle": { "type": "string", "maxLength": 120 },
        "siteDescription": { "type": "string", "maxLength": 240 },
        "faviconRef": { "$ref": "#/$defs/imageKey" }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "slug", "description", "sortOrder", "active"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 500 },
        "sortOrder": { "type": "integer", "minimum": -100000, "maximum": 100000 },
        "active": { "type": "boolean" }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "collectionKey", "name", "slug", "sortOrder", "active"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "collectionKey": {
          "description": "Compatibility field; always null.",
          "type": "null"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 80 },
        "sortOrder": { "type": "integer", "minimum": -100000, "maximum": 100000 },
        "active": { "type": "boolean" }
      }
    },
    "optionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "values"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key", "collectionKey", "categoryKey", "name", "slug", "eyebrow",
        "description", "imageRef", "videoRef", "priceMinor", "currency",
        "quantityUnit", "highlights", "availability", "offeringKind",
        "quantityMode", "capacitySummary", "minimumOrderSummary",
        "leadTimeSummary", "published", "sortOrder", "optionGroups"
      ],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "collectionKey": {
          "description": "Compatibility field; always null.",
          "type": "null"
        },
        "categoryKey": { "$ref": "#/$defs/nullableKey" },
        "name": { "type": "string", "minLength": 1, "maxLength": 140 },
        "slug": { "type": "string", "maxLength": 80 },
        "eyebrow": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "imageRef": { "$ref": "#/$defs/imageKey" },
        "videoRef": { "$ref": "#/$defs/videoKey" },
        "priceMinor": {
          "description": "Optional informational ETB price in minor units; null omits the price.",
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0, "maximum": 999999999 }]
        },
        "currency": { "const": "ETB" },
        "quantityUnit": {
          "description": "Optional merchant-defined offered-by unit such as kg, piece, set, tonne, or project.",
          "type": "string",
          "maxLength": 40
        },
        "highlights": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "availability": {
          "enum": ["available", "limited", "unavailable", "coming_soon"]
        },
        "offeringKind": {
          "description": "What is being offered; choose from the business facts, not an industry stereotype.",
          "enum": ["standard_product", "made_to_order", "manufacturing_capability", "production_supply"]
        },
        "quantityMode": {
          "description": "Desired quantity is optional buyer intent, never inventory.",
          "enum": ["optional"]
        },
        "capacitySummary": {
          "description": "Optional factual production or supply capacity, including its period or basis.",
          "type": "string",
          "maxLength": 180
        },
        "minimumOrderSummary": {
          "description": "Optional factual minimum order or batch condition.",
          "type": "string",
          "maxLength": 140
        },
        "leadTimeSummary": {
          "description": "Optional factual lead-time or production-window statement.",
          "type": "string",
          "maxLength": 140
        },
        "published": { "type": "boolean" },
        "sortOrder": { "type": "integer", "minimum": -100000, "maximum": 100000 },
        "optionGroups": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/optionGroup" }
        }
      }
    }
  }
}
