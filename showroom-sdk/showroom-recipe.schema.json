{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suqpage.com/schemas/showroom-recipe.schema.json",
  "title": "SuqPage complete showroom recipe envelope",
  "description": "One complete replacement content-and-design proposal. Server authorization, supplied-provenance integrity, asset, reconciliation, and semantic validation remain authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "baseContentVersion", "content", "design", "summary",
    "rationale", "questions", "warnings", "mediaPlan", "declaredRemovals"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseContentVersion": { "type": "integer", "minimum": 1 },
    "content": { "$ref": "showroom-content.schema.json" },
    "design": { "$ref": "showroom-proposal-v2.schema.json" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "rationale": { "type": "string", "maxLength": 2000 },
    "questions": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "mediaPlan": {
      "type": "array",
      "maxItems": 160,
      "items": { "$ref": "#/$defs/mediaPlanSlot" }
    },
    "declaredRemovals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collections", "categories", "products"],
      "properties": {
        "collections": {
          "description": "Compatibility field; always empty.",
          "type": "array",
          "maxItems": 0
        },
        "categories": { "$ref": "#/$defs/keyList200" },
        "products": { "$ref": "#/$defs/keyList500" }
      }
    },
    "provenance": {
      "description": "Optional review metadata. Empty or omitted provenance is valid for provisional private-draft copy.",
      "type": "array",
      "maxItems": 4000,
      "items": { "$ref": "#/$defs/provenance" }
    }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
    "keyList100": {
      "type": "array", "maxItems": 100, "uniqueItems": true,
      "items": { "$ref": "#/$defs/key" }
    },
    "keyList200": {
      "type": "array", "maxItems": 200, "uniqueItems": true,
      "items": { "$ref": "#/$defs/key" }
    },
    "keyList500": {
      "type": "array", "maxItems": 500, "uniqueItems": true,
      "items": { "$ref": "#/$defs/key" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sourceKey", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 300 },
        "sourceKey": {
          "type": "string",
          "pattern": "^source_[a-f0-9]{20}$",
          "maxLength": 100
        },
        "kind": { "enum": ["source_fact", "ai_draft"] }
      }
    },
    "mediaPlanSlot": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "ownerType": { "const": "business" } }, "required": ["ownerType"] },
          "then": {
            "properties": {
              "ownerKey": { "const": "business" },
              "slotKey": { "enum": ["logo", "hero_image", "favicon"] }
            }
          }
        },
        {
          "if": { "properties": { "ownerType": { "const": "product" } }, "required": ["ownerType"] },
          "then": { "properties": { "slotKey": { "const": "product_image" } } }
        }
      ],
      "required": [
        "key", "ownerType", "ownerKey", "slotKey", "label", "purpose",
        "required", "aspectRatio", "altText", "classification"
      ],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "ownerType": { "enum": ["business", "product", "block"] },
        "ownerKey": { "$ref": "#/$defs/key" },
        "slotKey": { "$ref": "#/$defs/key" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 300 },
        "required": { "type": "boolean" },
        "aspectRatio": { "enum": ["any", "landscape", "portrait", "square"] },
        "altText": { "type": "string", "maxLength": 240 },
        "classification": { "enum": ["factual", "illustrative"] }
      }
    }
  }
}
