# Local development defaults. Copy this file to .env before running the app.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional comma-separated exact hosts for a trusted reverse proxy. Do not use a
# broad wildcard. Codespaces and the canonical app host are detected automatically.
SUQPAGE_SERVER_ACTION_ORIGINS=
SUQPAGE_DB_PATH=./data/suqpage.db
SUQPAGE_MEDIA_ROOT=./data/media
SUQPAGE_BACKUP_ROOT=./backups
# Emergency write-disable switch. Product upkeep is enabled unless set to 0.
SUQPAGE_PRODUCT_UPKEEP_ENABLED=1
# Emergency recipe-import disable. New drafts use the recovery editor when 0.
SUQPAGE_RECIPE_STUDIO_ENABLED=1
# Disabled until DEP-009 provider rollout gates pass.
SUQPAGE_YOUTUBE_ADMISSION_ENABLED=0
# Never persist this approval. Set it to 1 only for one stopped, verified
# destructive migration command after running npm run backup.
SUQPAGE_APPROVE_DESTRUCTIVE_MIGRATIONS=
# Optional; setup writes generated local login credentials here.
SUQPAGE_CREDENTIAL_PATH=./.local/seed-credentials.txt

# Required in production. Generate with: openssl rand -hex 32
PRIVACY_SALT=replace-with-at-least-24-random-characters

# Optional inquiry email notifications.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=SuqPage <notifications@suqpage.com>
