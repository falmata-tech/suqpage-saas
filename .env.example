# Local development uses the isolated Supabase CLI stack. Copy this file to a
# private environment file, then insert the local keys reported by
# `supabase status -o env`. Never reuse hosted production credentials locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MIRTPAGE_PWA_ENABLED=true
# Browser-visible basemap provider. Current production policy permits only the
# exact OSM Standard tile endpoint configured in lib/map-provider.ts.
NEXT_PUBLIC_MIRTPAGE_MAP_PROVIDER=osm-standard
# Optional exact public profiles used by Daily Featured Showrooms broadcasts.
NEXT_PUBLIC_MIRTPAGE_TIKTOK_URL=
NEXT_PUBLIC_MIRTPAGE_YOUTUBE_URL=
# Server-side canonical origin. Set both URLs to the exact generated production
# origin until an AfricMade domain is purchased and verified.
MIRTPAGE_CANONICAL_URL=
# Optional comma-separated exact hosts for a trusted reverse proxy. Do not use a
# broad wildcard. Codespaces and the canonical app host are detected automatically.
MIRTPAGE_SERVER_ACTION_ORIGINS=
MIRTPAGE_DB_PATH=./data/mirtpage.db
MIRTPAGE_DATABASE_DRIVER=postgres
# Required when MIRTPAGE_DATABASE_DRIVER=postgres. Use the Supabase transaction
# pooler URL for the serverless host and keep the direct URL for controlled operator scripts.
MIRTPAGE_POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct database URL used only by controlled migration/copy commands. Do not
# configure this in application runtime environments.
MIRTPAGE_POSTGRES_DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
MIRTPAGE_POSTGRES_MIGRATION_ROLE=
MIRTPAGE_POSTGRES_POOL_MAX=4
MIRTPAGE_POSTGRES_CONNECTION_TIMEOUT_MS=5000
MIRTPAGE_POSTGRES_STATEMENT_TIMEOUT_MS=8000
MIRTPAGE_MEDIA_ROOT=./data/media
# Mutable media defaults to the local filesystem. For a data-preserving Supabase
# Storage cutover, create one private bucket, run `npm run migrate:media`, then
# set the driver to supabase. Never expose the server credential to the browser.
MIRTPAGE_MEDIA_DRIVER=supabase
MIRTPAGE_SUPABASE_URL=http://127.0.0.1:54321
MIRTPAGE_SUPABASE_SERVICE_ROLE_KEY=
MIRTPAGE_SUPABASE_STORAGE_BUCKET=mirtpage-media
# Managed identity remains disabled until migration 37 and the aggregate auth
# reconciliation pass. The publishable key may reach the browser; the service
# role key above must remain server-only.
MIRTPAGE_AUTH_DRIVER=supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local Supabase delivers email codes to Mailpit. Production may set this to 1
# only after custom SMTP succeeds for a non-team address.
MIRTPAGE_EMAIL_OTP_ENABLED=1
# Production may set this to 1 only after Google OAuth callback tests pass.
MIRTPAGE_GOOGLE_AUTH_ENABLED=0
# Local Google OAuth uses a separate Web client. Put its values only in the
# ignored root .env; never reuse or copy hosted provider credentials here.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
MIRTPAGE_SUPABASE_AUTH_REQUEST_TIMEOUT_MS=8000
# One-command guard for the copy-only retained-user identity migration.
MIRTPAGE_APPROVE_AUTH_MIGRATION=
# Bounded server-to-storage deadline. Accepted range: 1000-30000 milliseconds.
MIRTPAGE_MEDIA_REQUEST_TIMEOUT_MS=8000
MIRTPAGE_BACKUP_ROOT=./backups
# Emergency write-disable switch. Product upkeep is enabled unless set to 0.
MIRTPAGE_PRODUCT_UPKEEP_ENABLED=1
# Emergency recipe-import disable. New drafts use the recovery editor when 0.
MIRTPAGE_RECIPE_STUDIO_ENABLED=1
# Disabled until DEP-009 provider rollout gates pass.
MIRTPAGE_YOUTUBE_ADMISSION_ENABLED=1
# Never persist this approval. Set it to 1 only for one stopped, verified
# destructive migration command after running npm run backup.
MIRTPAGE_APPROVE_DESTRUCTIVE_MIGRATIONS=
# One-command guard for the initial copy to an empty Supabase project.
MIRTPAGE_APPROVE_PRODUCTION_COPY=
# Optional; setup writes generated local login credentials here.
MIRTPAGE_CREDENTIAL_PATH=./.local/seed-credentials.txt

# Required in production. Generate with: openssl rand -hex 32
PRIVACY_SALT=replace-with-at-least-24-random-characters

# Optional inquiry email notifications.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# Optional support queue alert. Telegram receives only a reference and secure
# dashboard link, never the client's message body.
MIRTPAGE_TELEGRAM_BOT_TOKEN=
MIRTPAGE_TELEGRAM_SUPPORT_CHAT_ID=
# Optional client-visible emergency handoff. Use an official wa.me or
# api.whatsapp.com HTTPS URL. In-app support remains authoritative.
MIRTPAGE_SUPPORT_WHATSAPP_URL=
