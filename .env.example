# Local development uses the isolated Supabase CLI stack. Copy this file to a
# private environment file, then insert the local keys reported by
# `supabase status -o env`. Never reuse hosted production credentials locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUQPAGE_PWA_ENABLED=true
# Browser-visible basemap provider. Current production policy permits only the
# exact OSM Standard tile endpoint configured in lib/map-provider.ts.
NEXT_PUBLIC_SUQPAGE_MAP_PROVIDER=osm-standard
# Optional exact public profiles used by Daily Featured Showrooms broadcasts.
NEXT_PUBLIC_SUQPAGE_TIKTOK_URL=
NEXT_PUBLIC_SUQPAGE_YOUTUBE_URL=
# Server-side canonical origin. Set both URLs to the exact generated production
# origin until an Suqpage domain is purchased and verified.
SUQPAGE_CANONICAL_URL=
# Optional comma-separated exact hosts for a trusted reverse proxy. Do not use a
# broad wildcard. Codespaces and the canonical app host are detected automatically.
SUQPAGE_SERVER_ACTION_ORIGINS=
SUQPAGE_DATABASE_DRIVER=postgres
# Required when SUQPAGE_DATABASE_DRIVER=postgres. Use the Supabase transaction
# pooler URL for the serverless host and keep the direct URL for controlled operator scripts.
SUQPAGE_POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct database URL used only by controlled migration/copy commands. Do not
# configure this in application runtime environments.
SUQPAGE_POSTGRES_DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUQPAGE_POSTGRES_MIGRATION_ROLE=
SUQPAGE_POSTGRES_POOL_MAX=4
SUQPAGE_POSTGRES_CONNECTION_TIMEOUT_MS=5000
SUQPAGE_POSTGRES_STATEMENT_TIMEOUT_MS=8000
SUQPAGE_MEDIA_ROOT=./data/media
# Mutable media defaults to the local filesystem. For a data-preserving Supabase
# Storage cutover, create one private bucket, run `npm run migrate:media`, then
# set the driver to supabase. Never expose the server credential to the browser.
SUQPAGE_MEDIA_DRIVER=supabase
SUQPAGE_SUPABASE_URL=http://127.0.0.1:54321
SUQPAGE_SUPABASE_SERVICE_ROLE_KEY=
SUQPAGE_SUPABASE_STORAGE_BUCKET=mirtpage-media
# Managed identity remains disabled until migration 37 and the aggregate auth
# reconciliation pass. The publishable key may reach the browser; the service
# role key above must remain server-only.
SUQPAGE_AUTH_DRIVER=supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local Supabase delivers email codes to Mailpit. Production may set this to 1
# only after custom SMTP succeeds for a non-team address.
SUQPAGE_EMAIL_OTP_ENABLED=1
# Reserved for future OAuth restoration. Email-only policy currently ignores this flag.
SUQPAGE_GOOGLE_AUTH_ENABLED=0
# Local Google OAuth uses a separate Web client. Put its values only in the
# ignored root .env; never reuse or copy hosted provider credentials here.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
SUQPAGE_SUPABASE_AUTH_REQUEST_TIMEOUT_MS=8000
# One-command guard for the copy-only retained-user identity migration.
SUQPAGE_APPROVE_AUTH_MIGRATION=
# Bounded server-to-storage deadline. Accepted range: 1000-30000 milliseconds.
SUQPAGE_MEDIA_REQUEST_TIMEOUT_MS=8000
SUQPAGE_BACKUP_ROOT=./backups
# Emergency write-disable switch. Product upkeep is enabled unless set to 0.
SUQPAGE_PRODUCT_UPKEEP_ENABLED=1
# Emergency recipe-import disable. New drafts use the recovery editor when 0.
SUQPAGE_RECIPE_STUDIO_ENABLED=1
# Disabled until DEP-009 provider rollout gates pass.
SUQPAGE_YOUTUBE_ADMISSION_ENABLED=1
# Native PostgreSQL archives require pg_dump/pg_restore on PATH or this directory.
SUQPAGE_PG_BIN_DIR=
# Local-only alternative: the exact Supabase database container, verified by its port.
SUQPAGE_LOCAL_PG_CONTAINER=
# Supply the reviewed restore target digest for one restore command only.
SUQPAGE_APPROVE_POSTGRES_RESTORE=
# Optional; setup writes generated local login credentials here.
SUQPAGE_CREDENTIAL_PATH=./.local/seed-credentials.txt

# Required in production. Generate with: openssl rand -hex 32
PRIVACY_SALT=replace-with-at-least-24-random-characters

# Application shipment-tracking and overdue-staff email. Hosted sending stays
# deferred until one provider is configured and a real delivery is checked.
# Resend remains the default; Gmail is an explicit alternative using a separate
# server-only app password for the same account used by Supabase Auth.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
MIRTPAGE_TRANSACTIONAL_EMAIL_PROVIDER=
MIRTPAGE_SMTP_USER=
MIRTPAGE_SMTP_APP_PASSWORD=

# Optional support queue alert. Telegram receives only a reference and secure
# dashboard link, never the client's message body.
SUQPAGE_TELEGRAM_BOT_TOKEN=
SUQPAGE_TELEGRAM_SUPPORT_CHAT_ID=
# Optional client-visible emergency handoff. Use an official wa.me or
# api.whatsapp.com HTTPS URL. In-app support remains authoritative.
SUQPAGE_SUPPORT_WHATSAPP_URL=

# Optional S91 background notifications. In-app alerts work without these.
# Server-only VAPID pair and verified mailto: contact; never use EXPO_PUBLIC_ prefixes.
SUQPAGE_WEB_PUSH_PUBLIC_KEY=
SUQPAGE_WEB_PUSH_PRIVATE_KEY=
SUQPAGE_WEB_PUSH_SUBJECT=
SUQPAGE_NATIVE_PUSH_ENABLED=0
SUQPAGE_NATIVE_PUSH_MODE=
# EAS file environment variable containing reviewed Firebase Android client config.
# Private FCM V1 service-account credentials belong directly in EAS Credentials.
SUQPAGE_GOOGLE_SERVICES_FILE=
SUQPAGE_FIREBASE_PROJECT_ID=
SUQPAGE_MOBILE_NOTIFICATIONS_ENABLED=0
